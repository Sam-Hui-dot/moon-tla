name = "Sam-Hui-dot/moon-tla"

version = "0.1.0"

license = "Apache-2.0"

readme = "README.md"

repository = "https://github.com/Sam-Hui-dot/moon-tla"

keywords = [
  "tla",
  "tlaplus",
  "model-checker",
  "formal-methods",
  "distributed-systems",
  "verification",
]

description = "Pure-MoonBit TLA+ distributed protocol model checker, official TLC-compatible engine, native SVG counterexample trace visualizer, and zero-upload browser studio"

preferred_target = "wasm"

import {
  "moonbitlang/async@0.22.4",
}
